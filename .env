# ─────────────────────────────────────────────────────────
# Gmail → Google Sheets Automation — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Gmail address being monitored
GMAIL_ADDRESS=regenmarketing26@gmail.com

# Only process emails from this sender
SENDER_EMAIL=R.healey@arkleinsolvency.co.uk

# Google Sheet ID — found in the sheet URL:
# https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
#SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the Google Sheet to write rows into
SHEET_NAME=Sheet1

# How often to check for new emails (seconds). 60 = every minute.
POLL_INTERVAL_SEC=60

# Local file used to track which Gmail message IDs have been processed
PROCESSED_IDS_FILE=processed_ids.json

# Path to your downloaded OAuth credentials JSON from Google Cloud Console
CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be saved after first login
TOKEN_FILE=token.json
SPREADSHEET_ID=1bggrSflZQa3ZCng6TQXbf1vNrnQWDnOBZcjDoCcjdf4
